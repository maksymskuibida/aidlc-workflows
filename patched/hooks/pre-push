#!/usr/bin/env bash
# This fork tests on this machine instead of GitHub Actions. A push to main runs the fast local tests on
# the commit being pushed and also needs a full local run of that commit (see patched/scripts/test-local.sh).
# A tree that already has a recorded full pass (aidlc-tested-trees, keyed without patched/) skips the fast
# tier: the full run covered check, smoke, unit and integration, a superset of it, so a rebase or series
# move of tested code pushes at once. The fast tier tests the files changed since the remote's main when
# the push moves it forward; a push that rewrites history (a rebase, a series move) compares against where
# the commit leaves upstream/main instead, so it runs the files our patches touch and not every file
# upstream changed since the old base.
# Every other ref (branches cut from upstream/main have no patched/ folder, tags, deletes) is skipped before
# anything under patched/scripts is called. The clone's dispatcher (patched/hooks/fork-hooks/pre-push, RUNBOOK
# section 1a) runs this copy from the worktree that pushes.
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel)
COMMON=$(cd "$(git rev-parse --git-common-dir)" && pwd)
ZERO=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  [ "$remote_ref" = refs/heads/main ] || continue
  short=$(git rev-parse --short "$local_sha")
  key=$("$ROOT/patched/scripts/test-local.sh" key "$local_sha")
  if grep -qxF "$key" "$COMMON/aidlc-tested-trees" 2>/dev/null; then
    echo "pre-push: the full local run already covers the tree of $short; fast local tests skipped for $remote_ref"
    continue
  fi
  base=$remote_sha
  if [ "$base" = "$ZERO" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    base=$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null || true)
  elif ! git merge-base --is-ancestor "$base" "$local_sha"; then
    base=$(git merge-base "$local_sha" refs/remotes/upstream/main 2>/dev/null ||
      git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null || true)
    echo "pre-push: $remote_ref is rewritten; fast tests cover the test files changed since ${base:+$(git rev-parse --short "$base")}"
  fi
  echo "pre-push: fast local tests on $short for $remote_ref"
  if ! "$ROOT/patched/scripts/test-local.sh" fast "$local_sha" ${base:+"$base"}; then
    echo "pre-push: fast local tests failed on $short; nothing was pushed." >&2
    status=1
    continue
  fi
  echo "pre-push: main needs a full local run of $short first (smoke, unit and integration, in parallel; RUNBOOK section 1b):" >&2
  echo "  patched/scripts/test-local.sh full $short" >&2
  status=1
done
exit "$status"
